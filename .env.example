# ---- Vibe Recap environment ----
# Copy to .env and edit. Every value has a working default for a LAN install.

# TLS mode for Caddy: lan (self-signed internal CA), tailscale (Tailscale cert), domain (ACME/Let's Encrypt)
TLS_MODE=lan
# Hostname for tailscale/domain modes, e.g. recap.tail1234.ts.net or recap.example.com. Ignored in lan mode.
DOMAIN=localhost

# Where encrypted blobs, keys, and orphans live on the host.
RECAP_DATA=./data

# Postgres (bundled container). Change the password before first run.
POSTGRES_USER=recap
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=recap

# Optional passphrase that wraps the master key at /data/keys/master.key.
# If set, it must be present on every start. Leave empty for an unwrapped key on local disk.
MASTER_KEY_PASSPHRASE=

# Ollama. Default is the bundled container. To use an Ollama already running on the host,
# see compose.override.example.yml (ollama-proxy) and set OLLAMA_URL=http://ollama-proxy:11434.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_OCR_MODEL=glm-ocr
# Seconds one script attempt may take. CPU-only boxes need minutes. Also editable in Settings > General.
OLLAMA_TIMEOUT_S=600

# Vibe AI Router (default script-generation provider). Mint the app token in the router
# console (App tokens) and paste it here. The router's container name on vibe_net is usually
# vibe-ai-router; override VIBE_AI_ROUTER_HOST if yours differs. Leave the token empty to
# fall back to the bundled Ollama (also selectable in Settings > General).
VIBE_AI_TOKEN=
VIBE_AI_ROUTER_HOST=vibe-ai-router

# Worker concurrency (jobs processed at once). Keep at 1 on the reference box.
WORKER_CONCURRENCY=1

# Log level for api and worker: debug|info|warn|error
LOG_LEVEL=info

# Set to false only when running the API without TLS (local dev without Caddy).
COOKIE_SECURE=true

# Outgoing email (optional). Recap emails firm users only: invite links, password-reset links,
# and password-changed notices. Never clients. Provider: Emailit (https://emailit.com), key from
# Emailit > Settings > API keys. Sender address, sender name, and the on/off switch live in
# Settings > Email, where the key can also be entered instead of here.
EMAILIT_API_KEY=
# The address users open Recap at, used for links in emails, e.g. https://recap.yourfirm.com.
# Blank = the address of the request that triggered the message.
PUBLIC_URL=
